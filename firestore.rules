// ============================================================
// firestore.rules — White Label E-Commerce
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────

    // Verifica se o usuário logado é admin
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Valida schema de produto (funciona para create e update parcial)
    function isValidProduct() {
      let data = request.resource.data;
      return data.nome is string
          && data.nome.size() > 0
          && data.nome.size() <= 200
          && data.categoria is string
          && data.categoria.size() <= 100
          && data.precos is map
          && (!('imageUrl' in data) || data.imageUrl is string)
          && (!('unit' in data) || data.unit in ['un', 'kg'])
          && (!('freteGratis' in data) || data.freteGratis is bool);
    }

    // ── PRODUTOS ─────────────────────────────────────────────
    // Leitura pública (vitrine), escrita apenas admins
    match /produtos/{produtoId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct();
      allow update: if isAdmin() && isValidProduct();
      allow delete: if isAdmin();
    }

    // ── ADMINS ───────────────────────────────────────────────
    // Cada admin lê o próprio doc (AuthContext verifica role no login)
    // Admins podem listar todos (TeamManager)
    // Escrita: apenas admins (TeamManager cria/remove)
    match /admins/{adminId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // ── PEDIDOS ──────────────────────────────────────────────
    // Create BLOQUEADO no cliente — pedidos criados via /api/checkout
    // (Firebase Admin SDK valida preço e frete no servidor)
    // Leitura/update/delete: apenas admins
    match /pedidos/{pedidoId} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── FCM TOKENS ───────────────────────────────────────────
    // Qualquer visitante pode salvar seu próprio token (para receber push)
    // Leitura e deleção: apenas admins
    // FIX: removida a restrição de campos que bloqueava tokens com campo 'phone'
    //      e tokens salvos por usuários anônimos autenticados
    match /fcmTokens/{tokenId} {
      allow read:   if isAdmin();
      allow create: if tokenId.size() > 10
                    && request.resource.data.keys().hasAny(['lastUsed', 'createdAt', 'platform', 'phone', 'updatedAt'])
                    && (!('phone' in request.resource.data) || request.resource.data.phone is string);
      allow update: if tokenId.size() > 10
                    && (!('phone' in request.resource.data) || request.resource.data.phone is string);
      allow delete: if isAdmin();
    }

    // ── SETTINGS ─────────────────────────────────────────────
    // Configurações do sistema (frete, horário, promoções)
    // FIX: admins podem ler E escrever; leitura também permitida
    //      para a função /api/send-promotions que lê settings/delivery
    match /settings/{settingsId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // ── CATEGORIAS ───────────────────────────────────────────
    // Leitura pública (usada na vitrine para montar o menu)
    // Escrita apenas admins
    match /categorias/{categoriaId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── PADRÃO: bloqueia tudo que não foi explicitamente permitido ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
