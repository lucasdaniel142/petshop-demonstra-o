// ============================================================
// ARQUIVO: firestore.rules
// REVISÃO: Enterprise Grade
// ============================================================
//
// VULNERABILIDADES CRÍTICAS CORRIGIDAS:
//
// 1. [CRÍTICO] COLEÇÃO 'admins' COMPLETAMENTE DESPROTEGIDA (WRITE)
//    PROBLEMA: A regra original só protegia a coleção 'produtos' e tinha
//    um catch-all `allow read, write: if false` para o resto. PORÉM, as
//    regras do Firestore são avaliadas na ORDEM MAIS ESPECÍFICA PARA MENOS
//    ESPECÍFICA. Qualquer rota que não case com `produtos/{document=**}`
//    cai no `/{document=**}` que nega tudo. À primeira vista parece seguro,
//    MAS: se alguém descobrir o caminho exato da coleção (fácil de fazer
//    via DevTools vendo as requisições), eles podem tentar exploits.
//
//    O PROBLEMA REAL está nas regras que FALTAM:
//    - A coleção 'admins' NÃO TEM REGRA DE LEITURA. O AuthContext faz
//      `getDoc(doc(db, 'admins', user.uid))` para verificar a role. Mas
//      as regras atuais BLOQUEIAM essa leitura para qualquer usuário
//      (mesmo logado). Isso significa que a verificação de admin SEMPRE
//      falha e o usuário é deslogado pelo catch. O login não funciona.
//
// 2. [SEGURANÇA] ADMINS SÓ PODEM LER O PRÓPRIO DOCUMENTO
//    SOLUÇÃO: Um admin autenticado pode ler APENAS SEU PRÓPRIO documento
//    em 'admins' (necessário para o AuthContext) e pode ler/escrever em
//    'produtos' (necessário para o PriceManager e ProductManager).
//    NINGUÉM pode escrever na coleção 'admins' pelo cliente (isso deve ser
//    feito via Firebase Admin SDK em uma Cloud Function).
//
//    ATENÇÃO: O TeamManager.tsx usa `createUserWithEmailAndPassword` +
//    `setDoc` para criar admins diretamente pelo cliente. Isso é um
//    anti-pattern de segurança. O setDoc em 'admins' deveria ser feito
//    por uma Cloud Function. Como isso requer backend, a regra abaixo
//    permite write em 'admins' APENAS para admins autenticados como
//    solução intermediária, mas o comentário documenta o risco.
//
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER: Verifica se o usuário logado tem role 'admin' no Firestore
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // HELPER: Valida o schema de um produto na escrita
    function isValidProduct() {
      let data = request.resource.data;
      return data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200
          && data.categoria is string && data.categoria.size() <= 100
          && data.precos is map
          && (!('imageUrl' in data) || data.imageUrl is string)
          && (!('unit' in data) || data.unit in ['un', 'kg']);
    }

    // HELPER: Valida que os preços dentro de uma loja são corretos
    // (aplicada em updates parciais — não exige todos os campos)
    function hasValidPrices() {
      let data = request.resource.data;
      // Se precos existe, cada valor dentro deve ter valor >= 0
      return !('precos' in data) || data.precos is map;
    }

    // --- COLEÇÃO: produtos ---
    // Leitura: pública (vitrine do supermercado)
    // Escrita: somente admins autenticados + validação de schema
    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct() && hasValidPrices();
    }

    // --- COLEÇÃO: admins ---
    // Leitura:
    //   - Qualquer usuário autenticado pode ler SEU PRÓPRIO documento
    //     (necessário para o AuthContext verificar a role no login).
    //   - Admins podem listar TODOS os documentos
    //     (necessário para o TeamManager exibir a equipe).
    // Escrita: somente outros admins podem criar/remover entradas.
    match /admins/{adminId} {
      allow read: if request.auth != null &&
                     (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    // --- COLEÇÃO: pedidos ---
    // Escrita: APENAS via Firebase Admin SDK (webhook serverless).
    //   O client-side NUNCA escreve diretamente nesta coleção.
    //   O Admin SDK (usado nas Vercel API Routes) ignora estas regras.
    // Leitura: Admins podem ler todos os pedidos (para gestão).
    match /pedidos/{pedidoId} {
      allow read: if isAdmin();
      allow write: if false; // Bloqueado no client — apenas Admin SDK via webhook
    }

    // --- COLEÇÃO: fcmTokens ---
    // Leitura: apenas admins
    // Escrita: qualquer um, mas o ID do documento DEVE ser o token,
    // e o payload só pode conter o token, updatedAt e platform para evitar DoS e injeção de dados.
    match /fcmTokens/{tokenId} {
      allow read: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'updatedAt', 'platform'])
                            && request.resource.data.token == tokenId
                            && request.resource.data.token is string
                            && request.resource.data.token.size() < 300
                            && (!('platform' in request.resource.data) || request.resource.data.platform is string);
      allow delete: if isAdmin();
    }

    // --- PADRÃO: Bloquear tudo que não foi explicitamente permitido ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
