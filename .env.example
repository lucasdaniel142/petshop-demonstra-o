# ============================================================
# .env.example — Template de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite .env.local no repositório.
# ============================================================

# --- Firebase Client SDK ---
# Obtenha em: Firebase Console → Configurações do Projeto → Seus apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Chave mestra de criptografia (32 bytes hex) para proteger dados sensíveis
APP_ENCRYPTION_KEY=

# --- WhatsApp por Loja ---
# Formato: código do país (55) + DDD + número, sem espaços ou símbolos.
# Exemplo: 5582912345678 → Brasil (55) + DDD (82) + número
VITE_WHATSAPP_BENEDITO_BENTES=
VITE_WHATSAPP_SALVADOR_LYRA=
VITE_WHATSAPP_VERGEL_DO_LAGO=

# --- ImgBB (upload de imagens dos produtos) ---
# Obtenha em: https://api.imgbb.com/
VITE_IMGBB_API_KEY=

# --- Taxa de Entrega Dinâmica por Distância ---
# Coordenadas do supermercado (centro da área de entrega)
VITE_STORE_LAT=-9.6498
VITE_STORE_LNG=-35.7089

# Até DELIVERY_BASE_RADIUS_KM = cobra DELIVERY_BASE_FEE (taxa fixa)
# Acima disso = DELIVERY_BASE_FEE + (km extras × DELIVERY_PER_KM_FEE)
# Acima de DELIVERY_MAX_RADIUS_KM = recusa entrega
VITE_DELIVERY_BASE_FEE=5.00
VITE_DELIVERY_BASE_RADIUS_KM=3
VITE_DELIVERY_PER_KM_FEE=1.50
VITE_DELIVERY_MAX_RADIUS_KM=15

# --- Identidade da Loja (White Label) ---
# Esses valores personalizam o sistema para cada cliente.
VITE_STORE_NAME=Supermercado Exemplo
VITE_STORE_SHORT_NAME=Exemplo
VITE_STORE_WHATSAPP_GREETING=Olá!

# --- Horário de Funcionamento ---
# Formato 24h (HH:MM). Fora desse horário, o checkout é bloqueado.
VITE_STORE_OPEN_HOUR=07:00
VITE_STORE_CLOSE_HOUR=01:00

# --- Mercado Pago (Checkout Transparente) ---
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
# ATENÇÃO: MP_ACCESS_TOKEN é SERVER-SIDE ONLY (sem prefixo VITE_)
# Isso garante que a chave secreta NUNCA chegue ao bundle do navegador.
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxx
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxxxxxx
# Secret para validar assinatura HMAC do webhook (OBRIGATÓRIO em produção)
# Obtenha em: Painel MP → Webhooks → Chave secreta
# ⚠️ SEM ESSA CHAVE, o webhook REJEITA todas as notificações.
MP_WEBHOOK_SECRET=

# --- Firebase Admin (Server-Side Only) ---
# Cole o JSON inteiro da Service Account Key em UMA LINHA.
# Obtenha em: Firebase Console → Configurações → Contas de serviço → Gerar nova chave
# NUNCA use arquivos .json no repositório. Use apenas esta env var.
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Desenvolvimento local (API serverless emulada) ---
# Porta do scripts/dev-api-server.ts (Vite faz proxy /api → esta porta).
# DEV_API_PORT=8787

# --- Valor Mínimo de Pedido ---
# Subtotal mínimo (em reais) para aceitar um pedido online.
# Protege o modelo de negócio do cliente contra pedidos muito pequenos.
# --- Configuração de Domínio (CORS) ---
# Domínio real do cliente em produção (ex: https://loja.vercel.app)
# Necessário para restringir chamadas às APIs de notificação.
VITE_APP_URL=
