# ============================================================
# .env.example — Template de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite .env.local no repositório.
# ============================================================

# --- Firebase Client SDK ---
# Obtenha em: Firebase Console → Configurações do Projeto → Seus apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# --- Chave de criptografia (32 bytes hex) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# ============================================================
# IDENTIDADE DA LOJA (White Label)
# Personalize para qualquer tipo de negócio:
#   Supermercado, Açaíteria, Pet Shop, Farmácia, etc.
# ============================================================

# Nome completo que aparece no cabeçalho, notificações e WhatsApp
VITE_STORE_NAME=Minha Loja

# Nome curto para a aba do navegador e PWA
VITE_STORE_SHORT_NAME=Minha Loja

# Mensagem de saudação no pedido WhatsApp
VITE_STORE_WHATSAPP_GREETING=Olá! Gostaria de fazer um pedido.

# ============================================================
# FILIAIS / UNIDADES
# Formato: id:Label,id2:Label 2   (sem espaços ao redor de vírgulas)
# Uma loja com filial única: VITE_STORE_BRANCHES=principal:Loja Principal
# Múltiplas filiais: VITE_STORE_BRANCHES=centro:Centro,norte:Norte
# ============================================================
VITE_STORE_BRANCHES=principal:Loja Principal

# --- WhatsApp por Filial ---
# A chave deve ser: VITE_WHATSAPP_<ID_DA_FILIAL> (em maiúsculas)
# Exemplo para VITE_STORE_BRANCHES=principal:Loja Principal
VITE_WHATSAPP_PRINCIPAL=5511912345678

# --- Coordenadas das Filiais (para cálculo de frete) ---
# Formato: id:lat,lng separados por | entre filiais
# Exemplo: VITE_STORE_COORDINATES=principal:-23.5505,-46.6333|norte:-23.5100,-46.6100
VITE_STORE_COORDINATES=

# ============================================================
# ENTREGA
# ============================================================
VITE_DELIVERY_BASE_FEE=5.00
VITE_DELIVERY_BASE_RADIUS_KM=3
VITE_DELIVERY_PER_KM_FEE=1.50
VITE_DELIVERY_MAX_RADIUS_KM=15

# Frete grátis por valor mínimo
VITE_FREE_SHIPPING_MIN_VALUE_ENABLED=false
VITE_FREE_SHIPPING_MIN_VALUE=100.00

# ============================================================
# HORÁRIO DE FUNCIONAMENTO
# Formato 24h (HH:MM). Fora desse horário o checkout é bloqueado.
# ============================================================
VITE_STORE_OPEN_HOUR=07:00
VITE_STORE_CLOSE_HOUR=23:00

# --- ImgBB (upload de imagens dos produtos) ---
# Obtenha em: https://api.imgbb.com/
VITE_IMGBB_API_KEY=

# --- Firebase Admin (Server-Side Only) ---
# Cole o JSON inteiro da Service Account Key em UMA LINHA.
# Obtenha em: Firebase Console → Configurações → Contas de serviço → Gerar nova chave
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- URL do App em Produção (CORS) ---
# Exemplo: https://minha-loja.vercel.app
VITE_APP_URL=
