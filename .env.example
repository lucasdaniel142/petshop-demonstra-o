# ============================================================
# .env.example — Template de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite .env.local no repositório.
# ============================================================

# --- Firebase Client SDK ---
# Obtenha em: Firebase Console → Configurações do Projeto → Seus apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- WhatsApp por Loja ---
# Formato: código do país (55) + DDD + número, sem espaços ou símbolos.
# Exemplo: 5582912345678 → Brasil (55) + Alagoas (82) + número
VITE_WHATSAPP_BENEDITO_BENTES=
VITE_WHATSAPP_VERGEL=
VITE_WHATSAPP_SALVADOR_LYRA=

# --- ImgBB (upload de imagens dos produtos) ---
# Obtenha em: https://api.imgbb.com/
VITE_IMGBB_API_KEY=

# --- Taxa de Entrega por Loja (em reais) ---
# Valor numérico. Deixe 0 ou vazio para entrega grátis.
VITE_TAXA_BENEDITO_BENTES=5
VITE_TAXA_VERGEL=5
VITE_TAXA_SALVADOR_LYRA=5
